{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ComiCut",
  "version": "0.1.0",
  "identifier": "com.comicut.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ComiCut — AI Webtoon/Manga Montagem Video Maker",
        "width": 1360,
        "height": 860,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": ["$TEMP/comicut_cache/**"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/ffmpeg",
      "binaries/ffprobe"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE2OEFBMEUzQjdBM0I3MDIKUldRQ3Q2TzM0NkNLRmpiYlYrNEFjeWEzaXJmWG1Day8wV2lnYlFrV1hwRXBSZWF0VVNZYThnWVEK",
      "endpoints": [
        "https://github.com/NoviHe/comicut/releases/latest/download/latest.json"
      ]
    }
  }
}
